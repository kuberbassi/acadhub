generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum AttendanceStatus {
  present
  absent
  late
  approved_medical
  medical
  duty
  substituted
  cancelled
}

// ---------------------------------------------------------------------------
// Models
// ---------------------------------------------------------------------------

model User {
  id                   String   @id @default(cuid())
  google_id            String   @unique
  email                String   @unique
  name                 String
  picture              String?
  branch               String?
  course               String?
  college              String?
  batch                String?
  enrollment_number    String?
  admission_year       String?

  current_semester     Int      @default(1)
  target_attendance    Int      @default(75)
  attendance_threshold Int      @default(75)
  warning_threshold    Int      @default(76)
  biometrics           Json     @default("{}")
  created_at           DateTime @default(now())
  updated_at           DateTime @updatedAt

  subjects        Subject[]
  attendance_logs AttendanceLog[]
  manual_courses  ManualCourse[]
  timetables      Timetable[]
  system_logs     SystemLog[]
  user_backups    UserBackup[]
  user_preference UserPreference?
  sessions        UserSession[]

  @@map("users")
}

model UserSession {
  id                 String   @id @default(cuid())
  user_id            String
  device_id          String?
  refresh_token_hash String   @unique
  refresh_expires_at DateTime
  refresh_issued_at  DateTime @default(now())
  ip                 String?
  country_code       String?
  user_agent         String?
  last_active_at     DateTime @default(now())
  rotated_at         DateTime? // Grace period marker for concurrent requests
  created_at         DateTime @default(now())

  user               User     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@index([refresh_token_hash])
  @@map("user_sessions")
}


model Subject {
  id          String   @id @default(cuid())
  user_id     String
  name        String
  code        String   @default("")
  professor   String   @default("")
  classroom   String   @default("")
  semester    Int      @default(1)
  type        String   @default("theory")
  credits     Int?
  attended    Int      @default(0)
  total       Int      @default(0)
  target      Int      @default(75)
  categories  String[]
  practicals  Json?
  assignments Json?
  syllabus    String?
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  user            User            @relation(fields: [user_id], references: [id], onDelete: Cascade)
  attendance_logs AttendanceLog[]

  @@index([user_id])
  @@index([user_id, semester])
  @@index([user_id, name])
  @@map("subjects")
}

model AttendanceLog {
  id             String           @id @default(cuid())
  user_id        String
  subject_id     String
  subject_name   String
  date           String
  status         AttendanceStatus
  type           String           @default("Lecture")
  notes          String?
  semester       Int?
  substituted_by String?
  timestamp      DateTime         @default(now())

  user    User    @relation(fields: [user_id], references: [id], onDelete: Cascade)
  subject Subject @relation(fields: [subject_id], references: [id], onDelete: Cascade)

  @@unique([user_id, subject_id, date, type])
  @@index([user_id, date])
  @@index([user_id, subject_id])
  @@index([user_id, semester, date])
  @@index([user_id, semester]) // Added composite index
  @@map("attendance_logs")
}

model ManualCourse {
  id         String   @id @default(cuid())
  user_id    String
  name       String?
  platform   String?
  status     String?
  progress   Int      @default(0)
  url        String?
  notes      String?
  extra      Json?
  created_at DateTime @default(now())

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@map("manual_courses")
}

model Timetable {
  id         String   @id @default(cuid())
  user_id    String
  semester   Int      @default(1)
  schedule   Json     @default("{}")
  periods    Json?
  updated_at DateTime @default(now()) @updatedAt

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id, semester]) // Changed from @@unique to @@index to preserve historical duplicates
  @@index([user_id])
  @@map("timetable")
}

model SystemLog {
  id          String   @id @default(cuid())
  user_id     String
  action      String
  description String
  ip          String?
  user_agent  String?
  timestamp   DateTime @default(now())

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id, timestamp])
  @@map("system_logs")
}

model UserBackup {
  id          String   @id @default(cuid())
  user_id     String
  backup_type String   @default("pre_delete_auto")
  data        Json     @default("{}")
  created_at  DateTime @default(now())
  expires_at  DateTime

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@index([expires_at])
  @@map("user_backups")
}

model UserPreference {
  id          String   @id @default(cuid())
  user_id     String   @unique
  preferences Json     @default("{}")
  updated_at  DateTime @default(now()) @updatedAt

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@map("user_preferences")
}
